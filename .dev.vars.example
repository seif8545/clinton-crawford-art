# .dev.vars — Local Cloudflare Workers secrets (never commit this file)
# Used by `wrangler pages dev` for local development.
# Copy this file to .dev.vars and fill in your values.

ADMIN_PASSWORD=your-secure-admin-password-here

# Supabase — the URL and anon key are also in wrangler.toml (public).
# The service-role key is a SECRET and powers publishing (saving/deleting
# paintings and uploading images). Copy it from the Supabase dashboard:
# Project Settings → API → Project API keys → service_role → Reveal/Copy
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
