{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><!--X_avfg32D_NNIpCy3CGnd--><html lang=\"en\" class=\"scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/6fba7fdeaa157b73.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-cd229f2a63e065fb.js\"/><script src=\"/_next/static/chunks/4bd1b696-cf72ae8a39fa05aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/964-9e7fd12428968086.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-496fa17aa50c4504.js\" async=\"\"></script><script src=\"/_next/static/chunks/417-cea9edc3e4e6adf8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-a48b55db5078010c.js\" async=\"\"></script><script src=\"/_next/static/chunks/874-437a265a67d6cfee.js\" async=\"\"></script><script src=\"/_next/static/chunks/597-57efe7bf64c147ad.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-8bf8b27e0a0274c7.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>Dr. Clinton Crawford | Portals to Other Dimensions</title><meta name=\"description\" content=\"Original paintings by Dr. Clinton Crawford — Professor Emeritus, MFA. Works in magical realism exploring the threshold between the real and the otherworldly. Born in Guyana.\"/><meta name=\"keywords\" content=\"Clinton Crawford,magical realism,fine art,paintings,Guyana artist,Portals to Other Dimensions\"/><meta property=\"og:title\" content=\"Dr. Clinton Crawford | Portals to Other Dimensions\"/><meta property=\"og:description\" content=\"Original paintings exploring the threshold between real and imagined worlds.\"/><meta property=\"og:site_name\" content=\"Clinton Crawford Art\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Dr. Clinton Crawford | Portals to Other Dimensions\"/><meta name=\"twitter:description\" content=\"Original paintings exploring the threshold between real and imagined worlds.\"/><link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&amp;family=Lora:ital,wght@0,400;0,500;1,400&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/><style>\n          :root {\n            --font-cormorant: 'Cormorant Garamond', Georgia, serif;\n            --font-lora: 'Lora', Georgia, serif;\n            --font-mono: 'JetBrains Mono', monospace;\n          }\n        </style><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-parchment text-ink font-body antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent py-6\"><nav class=\"max-w-7xl mx-auto px-6 flex items-center justify-between\"><a class=\"group flex flex-col\" href=\"/\"><span class=\"font-display text-2xl text-ink tracking-wide group-hover:text-gold transition-colors duration-300\">Clinton Crawford</span><span class=\"text-xs text-dusk/60 tracking-[0.2em] uppercase font-body -mt-0.5\">Portals to Other Dimensions</span></a><div class=\"hidden md:flex items-center gap-10\"><a class=\"font-display text-lg tracking-wider transition-colors duration-200 text-ink/60 hover:text-ink\" href=\"/gallery\">Gallery</a><a class=\"font-display text-lg tracking-wider transition-colors duration-200 text-ink/60 hover:text-ink\" href=\"/about\">Artist</a><a class=\"relative flex items-center gap-2 text-ink/60 hover:text-gold transition-colors duration-200\" aria-label=\"Shopping cart\" href=\"/cart\"><svg width