ction\",null,{\"className\":\"py-24 px-6 border-y border-whisper relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"style\":{\"background\":\"linear-gradient(135deg, rgba(196,32,64,0.07) 0%, rgba(232,114,138,0.05) 40%, rgba(196,32,64,0.07) 100%)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-vellum -z-10\"}],[\"$\",\"div\",null,{\"className\":\"absolute left-0 top-0 bottom-0 w-1\",\"style\":{\"background\":\"linear-gradient(to bottom, transparent, rgba(196,32,64,0.3), transparent)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute right-0 top-0 bottom-0 w-1\",\"style\":{\"background\":\"linear-gradient(to bottom, transparent, rgba(196,32,64,0.3), transparent)\"}}],[\"$\",\"div\",null,{\"className\":\"max-w-4xl mx-auto text-center relative z-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display leading-none mb-4 select-none\",\"style\":{\"fontSize\":\"5rem\",\"color\":\"rgba(196,32,64,0.2)\"},\"children\":\"\\\"\"}],[\"$\",\"blockquote\",null,{\"className\":\"font-display text-2xl md:text-4xl italic leading-snug mb-6\",\"style\":{\"color\":\"rgba(44,31,20,0.78)\"},\"children\":\"Generally I let my canvas and initial brush strokes guide my composition. The images evince from the uncensored interplay with my dream consciousness state and my lived experiences.\"}],[\"$\",\"div\",null,{\"className\":\"w-16 h-px mx-auto mb-5\",\"style\":{\"background\":\"linear-gradient(to right, transparent, rgba(196,32,64,0.5), transparent)\"}}],[\"$\",\"cite\",null,{\"className\":\"text-sm tracking-[0.2em] uppercase font-body not-italic\",\"style\":{\"color\":\"rgba(196,32,64,0.6)\"},\"children\":\"— Dr. Clinton Crawford\"}]]}]]}]\n1f:[\"$\",\"section\",null,{\"className\":\"py-24 px-6 max-w-7xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col md:flex-row items-start md:items-end justify-between mb-16 gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"class