ed mb-8\",\"children\":\"Symbolic logic is at the base of every creation. Life begins with an egg — it reoccurs throughout. Without water, there is no life.\"}],[\"$\",\"$L6\",null,{\"href\":\"/about\",\"className\":\"btn-ghost\",\"children\":\"Read the Artist Statement →\"}]]}],[\"$\",\"div\",null,{\"className\":\"glass-card p-10\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-3xl text-gold mb-2\",\"children\":\"Portals to Other Dimensions\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-dusk/50 tracking-widest uppercase mb-6 font-body\",\"children\":\"Series of Twelve · Acrylics on Canvas\"}],[\"$\",\"p\",null,{\"className\":\"text-dusk/70 font-body leading-relaxed mb-8\",\"children\":\"Each work illustrates a threshold — a portal — between the known world and realms that exist only in the space between waking and dreaming.\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-3 gap-6 border-t border-whisper pt-8\",\"children\":[[\"$\",\"div\",\"Works\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-3xl text-ink\",\"children\":\"12\"}],[\"$\",\"div\",null,{\"className\":\"text-xs text-dusk/50 tracking-widest uppercase font-body mt-1\",\"children\":\"Works\"}]]}],[\"$\",\"div\",\"Medium\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"font-display text-3xl text-ink\",\"children\":\"Acrylic\"}],[\"$\",\"div\",null,{\"className\":\"text-xs text-dusk/50 tracking-widest uppercase font-body mt-1\",\"children\":\"Medium\"}]]}]]}]]}]]}]}]}]\n21:[\"$\",\"section\",null,{\"className\":\"py-14 px-6 border-y border-whisper overflow-hidden bg-parchment\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-center gap-16 whitespace-nowrap\",\"style\":{\"animation\":\"marquee 24s linear infinite\"},\"children\":[[\"$\",\"span\",\"0\",{\"className\":\"font-display text-lg shrink-0 text-dusk/30\",\"children\":\"Born in Guyana, South America\"}],[\"$\",\"span\",\"1\",{\"className\":\"font-display text-lg shrink-0 text-g