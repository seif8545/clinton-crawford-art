d/20 to-transparent\" style=\"top:85%\"></div></div><div class=\"absolute inset-0 overflow-hidden pointer-events-none\"><div class=\"absolute rounded-full\" style=\"width:4.789215017565251px;height:4.113341100060989px;top:57.66667902406739%;left:23.47046327577422%;background:#B8882A;opacity:0.33611605411240075;animation:float 7.730501703286682s ease-in-out 1.9835989124635298s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:4.725473756496152px;height:4.335096729880452px;top:46.38413552352443%;left:41.76654262120818%;background:#D4958A;opacity:0.24780689661131874;animation:float 7.590417357202349s ease-in-out 0.5502922213862762s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.065518691377088px;height:3.8586703327808234px;top:50.194179393743156%;left:65.89048347208455%;background:#8FAEC8;opacity:0.3461125605048613;animation:float 6.963414086038302s ease-in-out 0.7612674374742254s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:4.794087614948672px;height:5.02460292389205px;top:25.603487472646002%;left:11.42059104245261%;background:#B8882A;opacity:0.13153563528803047;animation:float 4.112066270736771s ease-in-out 1.002576259493897s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.9235943488609974px;height:4.401356762098932px;top:66.26104168016718%;left:32.76204335597066%;background:#D4958A;opacity:0.35282592220515796;animation:float 7.388332062825842s ease-in-out 0.5259876961038681s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.5831621863996057px;height:3.486368285736165px;top:75.09073886492766%;left:19.846685874865866%;background:#8FAEC8;opacity:0.31969899966587245;animation:float 4.358311473112394s ease-in-out 1.4591422298183727s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.844299603507582px;height:4.577921942231317px;top:18.058511466227344%;left:53.038025507926776%;background:#B8882A;opacity:0.22336969683838578;animation:float 7.479853243014777s ease-in-out 1.3553571948411345s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.963474896504323px;height:5.493390707809917px;top:64.74154328594865%;left:66.77590389095836%;background:#D4958A;opacity:0.29344172473579405;animation:float 5.051131868080281s ease-in-out 1.3961029843474129s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:4.44341918376984px;height:4.589580795559304px;top:50.10034710186664%;left:49.396125765336784%;background:#8FAEC8;opacity:0.21445807064205405;animation:float 7.4141095976759726s ease-in-out 1.463365078338641s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:2.2965223550946128px;height:4.506419356755487px;top:42.737118213631355%;left:91.30753449830335%;background:#B8882A;opacity:0.10326812948850735;animation:float 4.144497339218254s ease-in-out 1.9756486332793037s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:5.067125889638549px;height:3.347916332870943px;top:18.741175437383227%;left:10.569743937359766%;background:#D4958A;opacity:0.3788821762040735;animation:float 4.355558813005812s ease-in-out 0.14288375661172692s infinite\"></div><div class=\"absolute rounded-full\" style=\"width:4.0602467196326115px;height:5.668420544521517px;top:98.52855900097266%;left:41.03546738365394%;background:#8FAEC8;opacity:0.28903222817045676;animation:float 5.925854539520059s ease-in-out 0.9932848561295962s infinite\"></div></div><div class=\"relative z-10 text-center max-w-5xl mx-auto px-6 py-32\"><p class=\"font-body text-xs tracking-[0.45em] uppercase text-dusk/50 mb-6 animate-fade-up opacity-0 animate-delay-100\">Professor Emeritus · MFA · Guyana / United States</p><h1 class=\"font-display text-ink mb-4 animate-fade-up opacity-0 animate-delay-200\" style=\"font-size:clamp(4rem, 12vw, 10rem);line-height:0.88\">Clinton<br/><span class=\"text-gold-shimmer\">Crawford</span></h1><div class=\"flex items-center justify-center gap-6 my-10 animate-fade-up opacity-0 animate-delay-300\"><div class=\"divider-gold w-24\"></div><p class=\"font-display text-xl md:text-2xl text-dusk/70 italic tracking-wide\">Portals to Other Dimensions</p><div class=\"divider-gold w-24\"></div></div><p class=\"font-body text-base md:text-lg text-dusk/65 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-up opacity-0 animate-delay-400\">Works in magical realism where sky and water are interchangeable, land formations belong to imagined geographies, and the viewer is invited to step through the canvas into an otherworldly consciousness.</p><div class=\"flex flex-col sm:flex-row gap-4 justify-center animate-fade-up opacity-0 animate-delay-500\"><a class=\"btn-portal\" href=\"/gallery\">Enter the Gallery</a><a class=\"btn-ghost\" href=\"/about\">About the Artist</a></div></div><div class=\"absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30\" style=\"animation:float 3s ease-in-out infinite\"><span class=\"text-xs text-dusk tracking-[0.3em] uppercase font-body\">Scroll</span><div class=\"w-px h-10 bg-gradient-to-b from-gold/60 to-transparent\"></div></div></section><section class=\"py-24 px-6 border-y border-whisper relative overflow-hidden\"><div class=\"absolute inset-0\" style=\"background:linear-gradient(135deg, rgba(196,32,64,0.07) 0%, rgba(232,114,138,0.05) 40%, rgba(196,32,64,0.07) 100%)\"></div><div class=\"absolute inset-0 bg-vellum -z-10\"></div><div class=\"absolute left-0 top-0 bottom-0 w-1\" style=\"background:linear-gradient(to bottom, transparent, rgba(196,32,64,0.3), transparent)\"></div><div class=\"absolute right-0 top-0 bottom-0 w-1\" style=\"background:linear-gradient(to bottom, transparent, rgba(196,32,64,0.3), transparent)\"></div><div class=\"max-w-4xl mx-auto text-center relative z-10\"><div class=\"font-display leading-none mb-4 select-none\" style=\"font-size:5rem;color:rgba(196,32,64,0.2)\">&quot;</div><blockquote class=\"font-display text-2xl md:text-4xl italic leading-snug mb-6\" style=\"color:rgba(44,31,20,0.78)\">Generally I let my canvas and initial brush strokes guide my composition. The images evince from the uncensored interplay with my dream consciousness state and my lived experiences.</blockquote><div class=\"w-16 h-px mx-auto mb-5\" style=\"background:linear-gradient(to right, transparent, rgba(196,32,64,0.5), transparent)\"></div><cite class=\"text-sm tracking-[0.2em] uppercase font-body not-italic\" style=\"color:rgba(196,32,64,0.6)\">— Dr. Clinton Crawford</cite></div></section><section class=\"py-24 px-6 max-w-7xl mx-auto\"><div class=\"flex flex-col md:flex-row items-start md:items-end justify-between mb-16 gap-6\"><div><p class=\"text-xs text-gold tracking-[0.3em] uppercase font-body mb-3\">Current Series</p><h2 class=\"font-display text-5xl md:text-7xl text-ink leading-none\">Featured Works</h2></div><a class=\"btn-ghost shrink-0\" href=\"/gallery\">View All Works →</a></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\"><div class=\"aspect-[3/4] bg-vellum border border-whisper animate-pulse\"></div><div class=\"aspect-[3/4] bg-vellum border border-whisper animate-pulse\"></div><div class=\"aspect-[3/4] bg-vellum border border-whisper animate-pulse\"></div><div class=\"aspect-[3/4] bg-vellum border border-whisper animate-pulse\"></div></div></section><section class=\"py-24 px-6 border-t border-whisper bg-vellum/50\"><div class=\"max-w-7xl mx-auto\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\"><div><p class=\"text-xs text-gold tracking-[0.3em] uppercase font-body mb-4\">The Work</p><h2 class=\"font-display text-5xl md:text-6xl text-ink mb-6 leading-none\">Magical<br/><span class=\"text-blush italic\">Realism</span></h2><div class=\"w-12 h-px bg-gold/40 mb-6\"></div><p class=\"text-dusk/70 font-body leading-relaxed mb-4\">A juxtaposition of what we commonly call the real world alongside the world of an otherworldly consciousness. Sky and water are no longer separate entities — they become fluid and interchangeable.</p><p class=\"text-dusk/70 font-body leading-relaxed mb-8\">Symbolic logic is at the base of every creation. Life begins with an egg — it reoccurs throughout. Without water, there is no life.</p><a class=\"btn-ghost\" href=\"/about\">Read the Artist Statement →</a></div><div class=\"glass-card p-10\"><h3 class=\"font-display text-3xl text-gold mb-2\">Portals to Other Dimensions</h3><p class=\"text-xs text-dusk/50 tracking-widest uppercase mb-6 font-body\">Series of Twelve · Acrylics on Canvas</p><p class=\"text-dusk/70 font-body leading-relaxed mb-8\">Each work illustrates a threshold — a portal — between the known world and realms that exist only in the space between waking and dreaming.</p><div class=\"grid grid-cols-3 gap-6 border-t border-whisper pt-8\"><div><div class=\"font-display text-3xl text-ink\">12</div><div class=\"text-xs text-dusk/50 tracking-widest uppercase font-body mt-1\">Works</div></div><div><div class=\"font-display text-3xl text-ink\">Acrylic</div><div class=\"text-xs text-dusk/50 tracking-widest uppercase font-body mt-1\">Medium</div></div></div></div></div></div></section><section class=\"py-14 px-6 border-y border-whisper overflow-hidden bg-parchment\"><div class=\"flex items-center gap-16 whitespace-nowrap\" style=\"animation:marquee 24s linear infinite\"><span class=\"font-display text-lg shrink-0 text-dusk/30\">Born in Guyana, South America</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">MFA · UC Santa Barbara</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Professor Emeritus</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Specialist in Classical African Civilizations</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Travels to the Nile Valley</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Self-Taught from Age 7</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Works in Magical Realism</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Born in Guyana, South America</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">MFA · UC Santa Barbara</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Professor Emeritus</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Specialist in Classical African Civilizations</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Travels to the Nile Valley</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Self-Taught from Age 7</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span><span class=\"font-display text-lg shrink-0 text-dusk/30\">Works in Magical Realism</span><span class=\"font-display text-lg shrink-0 text-gold\">·</span></div></section><section class=\"py-32 px-6 text-center relative overflow-hidden\"><div class=\"absolute inset-0\" style=\"background:radial-gradient(ellipse at center, rgba(212,149,138,0.12) 0%, transparent 70%)\"></div><div class=\"relative z-10 max-w-3xl mx-auto\"><p class=\"text-xs text-gold tracking-[0.4em] uppercase font-body mb-6\">Acquire a Work</p><h2 class=\"font-display text-5xl md:text-7xl text-ink mb-6\">Own a Portal</h2><p class=\"text-dusk/60 font-body max-w-xl mx-auto mb-10 leading-relaxed\">Each piece is an original, signed work. Certificates of authenticity included. Worldwide shipping with full insurance.</p><a class=\"btn-portal\" href=\"/gallery\">Browse Available Works</a></div></section></main><footer class=\"relative border-t border-whisper bg-vellum\"><div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-96 h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent\"></div><div class=\"max-w-7xl mx-auto px-6 py-16\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 mb-12\"><div><h3 class=\"font-display text-3xl text-ink mb-2\">Clinton Crawford</h3><p class=\"text-xs text-dusk/50 tracking-[0.25em] uppercase mb-4\">Professor Emeritus · MFA · Artist</p><p class=\"text-sm text-dusk/70 font-body leading-relaxed max-w-xs\">Born in Guyana, South America. Works in magical realism exploring portals between real and imagined worlds.</p></div><div><h4 class=\"font-display text-xl text-gold mb-4 tracking-wide\">Explore</h4><ul class=\"space-y-2\"><li><a class=\"text-dusk/60 hover:text-ink text-sm font-body transition-colors duration-200 tracking-wide\" href=\"/gallery\">Gallery</a></li><li><a class=\"text-dusk/60 hover:text-ink text-sm font-body transition-colors duration-200 tracking-wide\" href=\"/gallery?series=Portals+to+Other+Dimensions\">Portals Series</a></li><li><a class=\"text-dusk/60 hover:text-ink text-sm font-body transition-colors duration-200 tracking-wide\" href=\"/about\">About the Artist</a></li><li><a class=\"text-dusk/60 hover:text-ink text-sm font-body transition-colors duration-200 tracking-wide\" href=\"/cart\">Cart</a></li></ul></div><div><h4 class=\"font-display text-xl text-gold mb-4 tracking-wide\">Acquire a Work</h4><p class=\"text-sm text-dusk/60 font-body mb-4 leading-relaxed\">Interested in a piece or a commission? All inquiries are handled with care.</p><a href=\"mailto:inquiries@clintoncrawfordart.com\" class=\"inline-flex items-center gap-2 text-sm text-blush hover:text-gold transition-colors duration-200\"><span>inquiries@clintoncrawfordart.com</span><span>→</span></a><p class=\"text-xs text-dusk/40 mt-4 font-body\">Based in the United States. Ships worldwide.</p></div></div><div class=\"w-full h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent mb-8\"></div><div class=\"flex flex-col md:flex-row items-center justify-between gap-4\"><p class=\"text-xs text-dusk/40 font-body tracking-wide\">© <!-- -->2026<!-- --> Dr. Clinton Crawford. All rights reserved.</p><p class=\"text-xs text-dusk/35 font-body italic\">&quot;I have learnt to let go and not insist on controlling the outcome.&quot;</p></div></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-cd229f2a63e065fb.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[6213,[\\\"417\\\",\\\"static/chunks/417-cea9edc3e4e6adf8.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-a48b55db5078010c.js\\\"],\\\"CartProvider\\\"]\\n3:I[7555,[],\\\"\\\"]\\n4:I[1295,[],\\\"\\\"]\\n5:I[5494,[\\\"874\\\",\\\"static/chunks/874-437a265a67d6cfee.js\\\",\\\"417\\\",\\\"static/chunks/417-cea9edc3e4e6adf8.js\\\",\\\"597\\\",\\\"static/chunks/597-57efe7bf64c147ad.js\\\",\\\"974\\\",\\\"static/chunks/app/page-8bf8b27e0a0274c7.js\\\"],\\\"default\\\"]\\n6:I[6874,[\\\"874\\\",\\\"static/chunks/874-437a265a67d6cfee.js\\\",\\\"417\\\",\\\"static/chunks/417-cea9edc3e4e6adf8.js\\\",\\\"597\\\",\\\"static/chunks/597-57efe7bf64c147ad.js\\\",\\\"974\\\",\\\"static/chunks/app/page-8bf8b27e0a0274c7.js\\\"],\\\"\\\"]\\nd:I[8393,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/6fba7fdeaa157b73.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"X_avfg32D_NNIpCy3CGnd\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\